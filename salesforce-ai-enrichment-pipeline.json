          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// 1. On récupère les données du nœud précédent (l'IA)\nlet inputData = $input.first().json;\n\n// 2. Vérification de sécurité : est-ce que l'IA a bien répondu ?\nif (!inputData || !inputData.output) {\n    if (inputData && inputData.error) {\n        throw new Error(\"Erreur de l'API IA : \" + inputData.error.message);\n    }\n    throw new Error(\"Aucune donnée 'output' reçue de l'IA. Vérifiez que le nœud 'Message a model' s'est bien exécuté (limite de requêtes atteinte ?).\");\n}\n\n// 3. On extrait le texte (avec gestion des différentes structures possibles)\nlet rawText;\nif (inputData.output[0] && inputData.output[0].content && inputData.output[0].content[0]) {\n    rawText = inputData.output[0].content[0].text;\n} else {\n    throw new Error(\"La structure de la réponse de l'IA est inattendue.\");\n}\n\n// 4. On nettoie et on parse le JSON\nlet cleanText = rawText.replace(/```json/g, '').replace(/```/g, '').trim();\nlet parsedData = JSON.parse(cleanText);\n\n// 5. On récupère les données originales du Lead (pour l'ID)\nlet originalLead = $('Loop Over Items').item.json;\n\n// 6. On fusionne et on renvoie\nreturn {\n  ...originalLead,\n  ...parsedData\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1056,
        -512
      ],
